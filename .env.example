# Local development example — copy to `.env` and fill secrets
NODE_ENV=development
PORT=8080

# --- Local database: zero-setup SQLite ---
DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# --- Telegram bot ---
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
SUPPORT_USERNAME=your_support_username
SUPPORT_WHATSAPP=8801234567890
# Comma-separated Telegram numeric IDs with admin powers
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Cryptomus (optional) ---
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=

PUBLIC_URL=http://localhost:8080

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=change-me-to-a-long-random-string

CURRENCY=USD
PAYMENT_POLL_INTERVAL=45
ORDER_EXPIRY_MINUTES=60
# ============================================================
#  TELEBOT SHOP — Environment configuration
#  Copy to .env for local dev. On Railway, set these as Variables.
# ============================================================

# --- Core ---
# The port Railway/host injects. Leave default locally.
PORT=8080
# production | development
NODE_ENV=production

# --- Telegram ---
# Get from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# Comma-separated Telegram numeric user IDs that get in-bot admin powers.
# Find yours by messaging the bot and checking /whoami, or via @userinfobot.
ADMIN_TELEGRAM_IDS=111111111,222222222
# Public username of your support account, without @ (used in Support button)
SUPPORT_USERNAME=YourSupportUser
# Admin WhatsApp number, digits only (no + or spaces) -> shown as a wa.me button
SUPPORT_WHATSAPP=8801234567890

# --- Database (Railway Postgres plugin sets this automatically) ---
DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Cryptomus payment gateway ---
# From Cryptomus dashboard: Merchant settings -> API
CRYPTOMUS_MERCHANT_ID=your-merchant-uuid
CRYPTOMUS_PAYMENT_API_KEY=your-payment-api-key
# Optional: payout key (only needed if you use payouts)
CRYPTOMUS_PAYOUT_API_KEY=

# Public base URL of THIS service (no trailing slash).
# On Railway this is https://<your-app>.up.railway.app
# Cryptomus success/callback URLs are derived from it.
PUBLIC_URL=https://your-app.up.railway.app

# --- Admin panel ---
# Login credentials for the web admin panel (bootstrap admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
# Secret for signing admin session JWTs. Use a long random string.
JWT_SECRET=please-change-me-to-a-long-random-secret-string

# --- Behaviour ---
# Currency shown to users (display only; Cryptomus settles in crypto)
CURRENCY=USD
# How often (seconds) the background poller reconciles pending payments
PAYMENT_POLL_INTERVAL=45
# Minutes before an unpaid order/invoice is auto-expired
ORDER_EXPIRY_MINUTES=60
