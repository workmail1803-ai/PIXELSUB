// TeleBot Shop — data model
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Users (Telegram customers)
// ------------------------------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  telegramId   BigInt    @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  balance      Decimal   @default(0) @db.Decimal(12, 2) // store credit / wallet
  isBanned     Boolean   @default(false)
  isAdmin      Boolean   @default(false)
  totalSpent   Decimal   @default(0) @db.Decimal(12, 2)
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  orders Order[]

  @@index([createdAt])
  @@index([isBanned])
}

// ------------------------------------------------------------------
// Categories (optional grouping in the shop)
// ------------------------------------------------------------------
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  emoji     String    @default("📦")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products Product[]
}

// ------------------------------------------------------------------
// Products
// ------------------------------------------------------------------
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  emoji       String   @default("🛍️")
  description String   @default("")
  price       Decimal  @db.Decimal(12, 2)
  categoryId  Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // When true, delivery is pulled from StockItem inventory.
  // When false, product is "unlimited" and delivers a fixed template message.
  usesStock   Boolean  @default(true)
  // Delivered when usesStock = false (e.g. instructions), supports {order_id}
  fixedContent String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock     StockItem[]
  orderItems OrderItem[]

  @@index([isActive])
  @@index([categoryId])
}

// ------------------------------------------------------------------
// Stock items — the actual deliverable content (codes / accounts)
// ------------------------------------------------------------------
model StockItem {
  id          Int       @id @default(autoincrement())
  // Nullable so a product can be deleted without destroying the delivered
  // codes attached to past orders (SetNull instead of Cascade).
  productId   Int?
  content     String    // the secret delivered to the buyer
  isSold      Boolean   @default(false)
  soldAt      DateTime?
  orderItemId Int?
  createdAt   DateTime  @default(now())

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, isSold])
}

// ------------------------------------------------------------------
// Orders
// ------------------------------------------------------------------
enum OrderStatus {
  PENDING    // created, awaiting payment
  PAID       // payment confirmed
  DELIVERED  // goods handed to user
  CANCELLED  // user/admin cancelled
  EXPIRED    // timed out unpaid
  REFUNDED   // marked refunded by admin
  FAILED     // payment failed
}

enum PaymentMethod {
  CRYPTOMUS
  BINANCE // manual verification: customer pays the admin's Binance ID directly
  BALANCE
}

model Order {
  id             Int           @id @default(autoincrement())
  publicId       String        @unique // short human code shown to user, e.g. ORD-8FK2QA
  userId         Int
  status         OrderStatus   @default(PENDING)
  method         PaymentMethod @default(CRYPTOMUS)
  kind           String        @default("PURCHASE") // PURCHASE | TOPUP (wallet credit)
  amount         Decimal       @db.Decimal(12, 2) // total in display currency
  currency       String        @default("USD")

  // Cryptomus linkage
  invoiceUuid    String?       // Cryptomus payment uuid
  invoiceOrderId String?       @unique // order_id we send to Cryptomus
  payUrl         String?       // hosted checkout url
  payCurrency    String?       // crypto the user actually paid in
  payAmount      String?       // crypto amount
  network        String?

  paidAt         DateTime?
  deliveredAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  events     OrderEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  // Nullable: the line already snapshots name/emoji/price, so an order stays
  // fully readable after its product is deleted.
  productId  Int?
  productName String  // snapshot at purchase time
  emoji      String   @default("🛍️")
  unitPrice  Decimal  @db.Decimal(12, 2)
  quantity   Int
  lineTotal  Decimal  @db.Decimal(12, 2)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  stock   StockItem[] // fulfilled stock (for usesStock products)

  @@index([orderId])
}

// Audit trail per order (great for the admin panel timeline)
model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  type      String   // created | invoice_created | payment_received | delivered | expired | cancelled | note
  message   String   @default("")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ------------------------------------------------------------------
// Key/value settings editable from the admin panel
// ------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------
// Admin panel accounts
// ------------------------------------------------------------------
model AdminAccount {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("owner") // owner | staff
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------------------
// Broadcast log
// ------------------------------------------------------------------
model Broadcast {
  id         Int      @id @default(autoincrement())
  text       String
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------
// Wallet credit requests (user asks admin for store credit)
// ------------------------------------------------------------------
model CreditRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  telegramId BigInt
  username   String?
  amount     Decimal  @db.Decimal(12, 2)
  note       String   @default("")
  status     String   @default("PENDING") // PENDING | APPROVED | DECLINED
  createdAt  DateTime @default(now())

  @@index([status])
}
